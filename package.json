{
  "name": "blips-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Blips UI - Component Library Monorepo",
  "scripts": {
    "build": "turbo build --filter='@blips/*'",
    "dev": "turbo dev --filter='@blips/*'",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "registry:build": "pnpm --filter @blips/ui registry:build",
    "release": "pnpm --filter @blips/ui build && pnpm --filter @blips/ui publish --no-git-checks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}
